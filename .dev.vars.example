RESEND_API_KEY=
AUTH_EMAIL_FROM="Everybody's Platformer <onboarding@resend.dev>"
# Public app base URL used when constructing auth links from the Worker.
APP_BASE_URL="http://127.0.0.1:3000"
# Public Reown project id returned by /api/auth/session for wallet sign-in bootstrapping.
REOWN_PROJECT_ID=
# Debug-only local mode: return the magic link in the API response instead of sending email.
AUTH_DEBUG_MAGIC_LINKS=1
# Dev-only reset route for wiping test data through the Worker UI button.
ENABLE_TEST_RESET=1
CHAT_OWNER_EMAILS=
# Email address that receives approval-queue notifications for new comments/photos.
ADMIN_REVIEW_EMAIL=jonathan@jonathanmann.net
# Local normal-user room claim override for course/editor testing. Leave blank to use trust-tier caps.
ROOM_DAILY_CLAIM_LIMIT=4
# Local normal-user publish override for multi-room course/editor testing. Leave blank to use trust-tier caps.
ROOM_DAILY_PUBLISH_LIMIT=10
PLAYFUN_ROOM_DAILY_CLAIM_LIMIT=1
PLAYFUN_ROOM_MAX_PLACED_OBJECTS=16
PARTYKIT_HOST="127.0.0.1:1999"
PARTYKIT_PARTY="main"
PARTYKIT_INTERNAL_TOKEN=
ROOM_MINT_CHAIN_ID=84532
ROOM_MINT_CHAIN_NAME="Base Sepolia"
ROOM_MINT_RPC_URL=
ROOM_MINT_CONTRACT_ADDRESS=
ROOM_MINT_BLOCK_EXPLORER_URL="https://sepolia.basescan.org"
# Worker-side signer used for claimer-bound mint authorizations.
# This must match the contract's on-chain mintAuthority and should not be the owner key.
ROOM_MINT_AUTH_PRIVATE_KEY=

# Optional Play.fun integration for reward mode (`?pf=1`).
PLAYFUN_ENABLED=0
PLAYFUN_API_KEY=
PLAYFUN_SECRET_KEY=
PLAYFUN_GAME_ID=
PLAYFUN_BASE_URL="https://api.play.fun"

# Optional guestbook verification. Leave blank in local dev to bypass Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GUESTBOOK_IP_HASH_SALT=

# Optional user-uploaded room backgrounds.
# Configure these as Worker secrets/vars in Cloudflare before enabling real uploads.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_API_TOKEN=
CLOUDFLARE_IMAGES_ACCOUNT_HASH=
CLOUDFLARE_IMAGES_BACKGROUND_VARIANT=public
CLOUDFLARE_IMAGES_THUMB_VARIANT=public
BACKGROUND_UPLOAD_MAX_BYTES=8388608
BACKGROUND_UPLOAD_MIN_TRUST_TIER=T2
# Leave blank to require human approval for everyone. Set to T4 to auto-approve clean T4 uploads.
BACKGROUND_UPLOAD_AUTO_APPROVE_TRUST_TIER=
# Set to 1 to skip OpenRouter/Gemini moderation while still requiring human approval.
BACKGROUND_UPLOAD_SKIP_AI_MODERATION=0
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODERATION_MODEL=gemini-2.0-flash-lite

# Optional dynamic CryptoPunk avatar generation queue.
CRYPTOPUNK_AVATAR_R2_BUCKET=
CRYPTOPUNK_AVATAR_R2_PREFIX=avatars/cryptopunks
CRYPTOPUNK_AVATAR_PUBLIC_BASE_URL=
CRYPTOPUNK_AVATAR_MAX_JOBS=1
CRYPTOPUNK_AVATAR_STALE_AFTER_MINUTES=20
