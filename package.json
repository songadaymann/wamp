{
  "name": "everybodys-platformer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run test && npm run typecheck && npm run world-tiles:types:check && npm run build",
    "lint": "eslint src partykit scripts/api_performance_probe.mjs scripts/backfill_badges.mjs scripts/overworld_tile_pyramid_probe.mjs scripts/overworld_tile_pyramid_probe_helpers.mjs scripts/playable_content_index.mjs scripts/runtime_performance_trace.mjs scripts/runtime_performance_trace.test.ts scripts/webgl_recovery_probe.mjs scripts/world_tile_parity_probe.mjs scripts/world_tiles.mjs --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "dev": "vite --strictPort --port 3000",
    "dev:frontend:local": "VITE_ROOM_API_BASE_URL='' vite --strictPort --port 3000",
    "dev:frontend:remote": "VITE_ROOM_API_BASE_URL='https://everybodys-platformer.novox-robot.workers.dev' vite --strictPort --port 3000",
    "dev:api": "wrangler dev",
    "dev:api:remote": "wrangler dev --remote",
    "dev:presence": "partykit dev",
    "build": "tsc && vite build && node scripts/build_pages_worker.mjs",
    "preview": "vite preview",
    "smoke:mobile": "node scripts/mobile_smoke.mjs",
    "smoke:guest-claim": "npx --yes --quiet -p playwright node scripts/smoke_guest_claim_modal.mjs",
    "smoke:guest-builder-claim": "npx --yes --quiet -p playwright node scripts/smoke_guest_builder_claim_modal.mjs",
    "smoke:preview:readonly": "npx --yes --quiet -p playwright node scripts/preview_smoke_readonly.mjs",
    "smoke:progression-rating": "npx --yes --quiet -p playwright node scripts/smoke_progression_rating_modal.mjs",
    "smoke:progression-api:local": "node scripts/smoke_progression_api_flow.mjs",
    "smoke:dom-contract": "node scripts/smoke_dom_contract.mjs",
    "smoke:worker-safety": "npx --yes --quiet tsx scripts/worker_safety_probes.ts",
    "smoke:partykit-identity": "npx --yes --quiet tsx scripts/partykit_identity_token_probe.ts",
    "smoke:live-construction-play": "npx --yes --quiet tsx scripts/live_construction_play_smoke.ts",
    "smoke:prod": "node scripts/smoke_prod.mjs",
    "stress:presence": "node scripts/presence_load_test.mjs",
    "stress:presence:48": "node scripts/presence_load_test.mjs --counts=48 --no-observer=true",
    "stress:presence:150": "node scripts/presence_load_test.mjs --counts=150 --duration-ms=30000 --no-observer=true",
    "perf:api": "node scripts/api_performance_probe.mjs",
    "perf:runtime:mobile": "node scripts/runtime_performance_trace.mjs",
    "perf:webgl:recovery": "node scripts/webgl_recovery_probe.mjs",
    "perf:overworld:tiles": "node scripts/overworld_tile_pyramid_probe.mjs",
    "perf:overworld:tiles:parity": "node scripts/world_tile_parity_probe.mjs",
    "index:repair": "node scripts/playable_content_index.mjs repair",
    "index:parity": "node scripts/playable_content_index.mjs parity",
    "world-tiles:status": "node scripts/world_tiles.mjs status",
    "world-tiles:backfill": "node scripts/world_tiles.mjs backfill",
    "world-tiles:repair": "node scripts/world_tiles.mjs repair",
    "world-tiles:activate": "node scripts/world_tiles.mjs activate",
    "world-tiles:gc": "node scripts/world_tiles.mjs garbage-collect",
    "world-tiles:renderer:deploy:safety": "node scripts/world_tiles.mjs deploy-renderer --env safety",
    "world-tiles:renderer:deploy:production": "node scripts/world_tiles.mjs deploy-renderer --env production",
    "world-tiles:types:api": "wrangler types generated-bindings/api-worker-configuration.d.ts --env-interface ApiBindings --include-runtime false --strict-vars false",
    "world-tiles:types:renderer": "wrangler types generated-bindings/world-tile-renderer-worker-configuration.d.ts --config wrangler.world-tile-renderer.jsonc --env-interface WorldTileRendererBindings --include-runtime false --strict-vars false",
    "world-tiles:types": "npm run world-tiles:types:api && npm run world-tiles:types:renderer",
    "world-tiles:types:check": "wrangler types generated-bindings/api-worker-configuration.d.ts --env-interface ApiBindings --include-runtime false --strict-vars false --check && wrangler types generated-bindings/world-tile-renderer-worker-configuration.d.ts --config wrangler.world-tile-renderer.jsonc --env-interface WorldTileRendererBindings --include-runtime false --strict-vars false --check",
    "map-screenshot:dev": "wrangler dev --config wrangler.map-screenshot.jsonc --remote",
    "map-screenshot:deploy:safety": "wrangler deploy --config wrangler.map-screenshot.jsonc --env safety",
    "map-screenshot:deploy:production": "wrangler deploy --config wrangler.map-screenshot.jsonc",
    "map-screenshot:bucket:create": "wrangler r2 bucket create everybodys-platformer-map-screenshots && wrangler r2 bucket create everybodys-platformer-safety-map-screenshots",
    "badges:backfill": "node scripts/backfill_badges.mjs",
    "avatar:cryptopunk:build": "python3 gen-avatar/cryptopunk/build-avatar-pack-for-punk-id.py",
    "avatar:cryptopunk:build-preview-atlas": "python3 scripts/build_cryptopunk_head_preview_atlas.py",
    "avatar:cryptopunk:queue": "node scripts/process_cryptopunk_avatar_queue.mjs",
    "avatar:cryptopunk:queue:once": "node scripts/run_cryptopunk_avatar_queue_once.mjs",
    "avatar:cryptopunk:queue:install-launchd": "node scripts/install_cryptopunk_avatar_queue_launchd.mjs",
    "avatar:cryptopunk:queue:uninstall-launchd": "node scripts/install_cryptopunk_avatar_queue_launchd.mjs --uninstall",
    "avatar:cryptopunk:queue:safety": "node scripts/process_cryptopunk_avatar_queue.mjs --env safety",
    "avatar:cryptopunk:container:prepare": "node scripts/prepare_cryptopunk_avatar_container_context.mjs",
    "avatar:cryptopunk:container:deploy": "npm run avatar:cryptopunk:container:prepare && DOCKER_DEFAULT_PLATFORM=linux/amd64 wrangler deploy --config wrangler.cryptopunk-avatar-queue.jsonc --env \"\"",
    "avatar:cryptopunk:container:deploy:safety": "npm run avatar:cryptopunk:container:prepare && DOCKER_DEFAULT_PLATFORM=linux/amd64 wrangler deploy --config wrangler.cryptopunk-avatar-queue.jsonc --env safety",
    "contracts:build": "npm --prefix contracts run build",
    "contracts:test": "npm --prefix contracts run test",
    "contracts:deploy:base-sepolia": "npm --prefix contracts run deploy:base-sepolia",
    "db:safety:refresh:plan": "SAFETY_REFRESH_DRY_RUN=1 node scripts/refresh_safety_from_prod.mjs",
    "db:safety:refresh": "SAFETY_REFRESH_FROM_PROD=1 node scripts/refresh_safety_from_prod.mjs",
    "cf:d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "cf:d1:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "cf:d1:migrate:safety": "wrangler d1 migrations apply DB --env safety --remote",
    "cf:d1:migrate:jam:local": "wrangler d1 migrations apply wamp-solo-room-jam-db --local",
    "cf:d1:migrate:jam:remote": "wrangler d1 migrations apply wamp-solo-room-jam-db --remote",
    "cf:d1:migrate:jam:safety": "wrangler d1 migrations apply wamp-solo-room-jam-safety-db --env safety --remote",
    "rooms:sanitize-stacks": "npx tsx scripts/sanitize_placed_object_stacks.ts",
    "rooms:custom-tiles:migrate": "npx tsx scripts/convert_custom_sprite_objects_to_tiles.ts",
    "cf:deploy": "npm run build && wrangler deploy",
    "cf:deploy:safety": "npm run build && wrangler deploy --env safety",
    "deploy:safety:branch": "node scripts/deploy_safety_branch.mjs",
    "pages:deploy:prod": "node scripts/deploy_prod.mjs --pages-only --skip-smoke",
    "deploy:prod": "node scripts/deploy_prod.mjs",
    "presence:deploy:safety": "partykit deploy --config partykit.safety.json"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.3",
    "@cloudflare/puppeteer": "^1.1.0",
    "@reown/appkit": "^1.8.22",
    "@reown/appkit-adapter-wagmi": "^1.8.22",
    "@tonaljs/key": "^4.11.2",
    "jpeg-js": "^0.4.4",
    "partysocket": "^1.1.16",
    "phaser": "^3.87.0",
    "resend": "^6.9.3",
    "tonal": "^6.4.3",
    "viem": "^2.55.2",
    "wagmi": "^3.7.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "partykit": "^0.0.115",
    "playwright": "^1.59.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.71.0",
    "ws": "^8.21.1"
  },
  "optionalDependencies": {
    "utf-8-validate": "^5.0.10"
  }
}
