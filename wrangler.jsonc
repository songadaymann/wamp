{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "everybodys-platformer",
  "main": "src/cloudflare/worker.ts",
  "keep_vars": true,
  "compatibility_date": "2026-03-08",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "vars": {
    "JAM_SUBMISSIONS_OPEN_AT": "2026-07-20T04:00:00.000Z",
    "JAM_SUBMISSIONS_CLOSE_AT": "2026-07-27T03:59:59.999Z",
    "PARTYKIT_HOST": "everybodys-platformer-presence.songadaymann.partykit.dev",
    "PARTYKIT_PARTY": "main",
    "ROOM_DAILY_CLAIM_LIMIT": "4",
    "PLAYABLE_CONTENT_INDEX_READS": "0",
    "COMPACT_WORLD_READS": "0",
    "WORLD_TILE_GENERATION_ENABLED": "0",
    "TILED_OVERWORLD_READS": "0",
    "TILED_OVERWORLD_ROLLOUT_PERCENT": "0",
    "WORLD_TILE_PUBLIC_BASE_URL": "https://tiles.wamp.land"
  },
  "r2_buckets": [
    {
      "binding": "WORLD_TILE_BUCKET",
      "bucket_name": "everybodys-platformer-world-tiles"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "WORLD_TILE_QUEUE",
        "queue": "everybodys-platformer-world-tile-renders"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "everybodys-platformer-db",
      "database_id": "3cba45fc-4f29-4081-89f7-c57ab3179292",
      "migrations_dir": "./migrations"
    },
    {
      "binding": "JAM_DB",
      "database_name": "wamp-solo-room-jam-db",
      "database_id": "c642b3e2-cbb5-471a-bc13-95dc8c40488c",
      "migrations_dir": "./jam-migrations"
    }
  ],
  "env": {
    "safety": {
      "name": "everybodys-platformer-safety",
      "preview_urls": true,
      "vars": {
        "ENABLE_TEST_RESET": "0",
        "JAM_SUBMISSIONS_OPEN_AT": "2026-07-20T04:00:00.000Z",
        "JAM_SUBMISSIONS_CLOSE_AT": "2026-07-27T03:59:59.999Z",
        "PARTYKIT_HOST": "everybodys-platformer-presence-safety.songadaymann.partykit.dev",
        "PARTYKIT_PARTY": "main",
        "ROOM_MINT_DISABLED": "1",
        "ROOM_DAILY_CLAIM_LIMIT": "4",
        "PLAYABLE_CONTENT_INDEX_READS": "1",
        "COMPACT_WORLD_READS": "1",
        "WORLD_TILE_GENERATION_ENABLED": "0",
        "TILED_OVERWORLD_READS": "0",
        "TILED_OVERWORLD_ROLLOUT_PERCENT": "0",
        "WORLD_TILE_PUBLIC_BASE_URL": "https://tiles-safety.wamp.land"
      },
      "r2_buckets": [
        {
          "binding": "WORLD_TILE_BUCKET",
          "bucket_name": "everybodys-platformer-safety-world-tiles"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "WORLD_TILE_QUEUE",
            "queue": "everybodys-platformer-safety-world-tile-renders"
          }
        ]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "everybodys-platformer-safety-db",
          "database_id": "27f64d18-5d6d-45a0-9361-c09ec1a805a6",
          "migrations_dir": "./migrations"
        },
        {
          "binding": "JAM_DB",
          "database_name": "wamp-solo-room-jam-safety-db",
          "database_id": "78b05f25-732e-4162-8e7c-b6f71e3b058d",
          "migrations_dir": "./jam-migrations"
        }
      ]
    }
  }
}
